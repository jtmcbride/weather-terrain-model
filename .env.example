# Copy to .env to override any setting in backend/app/core/config.py.
# Every field there is settable as an environment variable of the same name.

# Point this at a local Copernicus GLO-90 GeoTIFF to read elevations from disk
# instead of the Open-Meteo elevation endpoint. Requires rasterio (see
# backend/requirements.txt).
# DEM_RASTER_PATH=/data/dem/bay-area-glo90.tif

# Where resampled elevation grids are cached. Terrain does not change, so this
# is written once per viewport and reused.
# DEM_CACHE_DIR=/app/.dem-cache

# Set to false to build fog grids from model samples only, with no live METARs.
# USE_METAR_OBSERVATIONS=true
